{
  "name": "buddygraph-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "BuddyGraph — the reference app built on the ringweave core. Deployed to GitHub Pages.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
